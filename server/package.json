{
  "name": "server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node ./src/app.js",
    "dev": "nodemon ./src/app.js --ext js, json, jsx",
    "mig": "npx sequelize db:migrate",
    "undoMig": "npx sequelize db:migrate:undo:all",
    "remigrate": "npx sequelize db:migrate:undo:all && npx sequelize db:migrate",
    "seed": "npx sequelize db:seed:all",
    "undoSeed": "npx sequelize db:seed:undo:all",
    "createDB": "npx sequelize db:create",
    "db": "npx sequelize db:drop && npx sequelize db:create  && npx sequelize db:migrate && npx sequelize db:seed:all"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.24.0"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "nodemon": "^3.1.9",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sequelize-cli": "^6.6.2"
  }
}
